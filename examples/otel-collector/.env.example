# Copy to .env and adjust to point the collector at your ClickHouse.
# Defaults below match the bundled clickhouse service in docker-compose.yml.

CLICKHOUSE_ENDPOINT=tcp://clickhouse:9000?dial_timeout=10s&compress=lz4
CLICKHOUSE_DATABASE=otel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Example for an external / managed ClickHouse:
# CLICKHOUSE_ENDPOINT=tcp://clickhouse.internal:9000?secure=true&dial_timeout=10s&compress=lz4
# CLICKHOUSE_DATABASE=lyzr_traces
# CLICKHOUSE_USER=otel_writer
# CLICKHOUSE_PASSWORD=replace-me
