# ComputerAgent harness — runs one of the example server entries via bun.
#
# Defaults to examples/computeragent-server.ts (full harness: /run + /sandboxes
# + /tasks + /snapshots, port 8787).
#
# Override the entry to build the BARE harness instead (just /v1/sessions/*
# on port 7700), used by the Python qa-worker:
#   docker build -f examples/Dockerfile.harness \
#     --build-arg ENTRY=examples/harness-server.ts \
#     -t harness-server .
#
# Same image layers in both cases — only the CMD differs.
#
# Build from the REPO ROOT so pnpm workspace resolution works:
#   docker build -f examples/Dockerfile.harness -t computeragent-harness .
#
# Uses the `local` runtime (no bwrap inside Docker — Docker IS the sandbox
# boundary). `git` is installed so the harness can clone agent sources at
# runtime. Session workdirs land in /tmp/computeragent-sessions which we
# mount as a named volume in docker-compose so they survive restarts.

FROM oven/bun:1-alpine AS builder
WORKDIR /app

# git for any postinstall, plus python3/make/g++ so native-gyp deps
# (better-sqlite3, cpu-features, etc.) can compile on alpine. Without
# the toolchain, `pnpm install --frozen-lockfile` exits non-zero on the
# first native postinstall. pnpm comes via bun's global install since
# the alpine bun image has no npm.
RUN apk add --no-cache git python3 make g++ pkgconfig \
 && bun install -g pnpm@9.4.0
ENV PATH="/root/.bun/install/global/node_modules/.bin:$PATH"

# Bring in the lockfile + workspace manifests + sources.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages packages
COPY examples examples

# Workspace install + targeted build.
#
# Split into two RUN steps and replaced `pnpm -r build || true` with a filtered
# build. The old one-liner `pnpm install --frozen-lockfile && pnpm -r build || true`
# was a sh `(A && B) || true`, so `|| true` silently masked install failures
# (native-gyp on alpine) AND any earlier-than-harness build failure — producing
# images with no node_modules or no packages/harness-server/dist/, which crashed
# at startup with `Cannot find package 'computeragent'` / `Cannot find module
# '@computeragent/harness-server'`.
#
# `pnpm --filter <pkg>...` (trailing ellipsis) builds <pkg> plus its transitive
# workspace deps. That covers everything the harness/examples actually need
# while skipping the known-failing @computeragent/cli package.
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @computeragent/harness-server... \
         --filter @computeragent/examples... build


# ── Runtime ────────────────────────────────────────────────────────────
FROM oven/bun:1-alpine
WORKDIR /app

RUN apk add --no-cache git ca-certificates

# Copy the whole built workspace. bun resolves workspace symlinks at runtime
# and we keep examples/ + packages/ + node_modules/ together so resolution
# doesn't break.
COPY --from=builder /app /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787

EXPOSE 8787

# Session workdirs live here. Mount a named volume for persistence (compose
# handles this).
VOLUME ["/tmp/computeragent-sessions"]

# Entry script — override at build time for the bare harness variant:
#   --build-arg ENTRY=examples/harness-server.ts
ARG ENTRY=examples/computeragent-server.ts
ENV ENTRY=${ENTRY}

# Shell form so $ENTRY is expanded at runtime by /bin/sh; `exec` keeps bun
# as PID 1 (signals + Docker stop semantics still work).
CMD exec bun run "$ENTRY"
