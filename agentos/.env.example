# AgentOS dev proxy config. Copy to .env.local and edit — both files are
# gitignored at the repo root, so secrets stay out of git.

# Where /api/* is proxied to in `vite dev`. Default points at the local
# combined agentos-server (packages/agentos-server) on :8788. Both /api/*
# and /obs-api/* ride to this same target by default.
# AGENTOS_API_TARGET=http://127.0.0.1:8788
# AGENTOS_API_TARGET=https://api.clawagent.sh

# Basic Auth for the production backend. Leave both unset for local — the
# proxy will skip the Authorization header entirely (no credential prompt).
# AGENTOS_API_USER=clawagent
# AGENTOS_API_PASS=

# Override only if you're running the legacy standalone observability-api
# process. Default = same target as /api.
# OBS_API_URL=http://127.0.0.1:7801
