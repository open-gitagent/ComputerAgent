  },
  "keywords": [
    "ai-agents",
    "agent-protocol",
    "harness-protocol",
    "anthropic",
    "claude",
    "sse",
    "typescript"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/protocol"
  }
