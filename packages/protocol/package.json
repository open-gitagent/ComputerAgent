{
  "name": "@computeragent/protocol",
  "version": "0.1.0",
  "description": "ComputerAgent Harness Protocol — type defs, zod schemas, EngineDriver and IdentityLoader contracts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
