{
  "name": "@open-gitagent/runtime-local",
  "version": "0.2.1",
  "description": "ComputerAgent substrate that boots the harness server in a managed local Node subprocess.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:bundle",
    "build:bundle": "bun build src/sandbox-boot.ts --target=node --outfile=assets/harness-bundle.mjs --format=esm --external @anthropic-ai/claude-agent-sdk --external @anthropic-ai/claude-code --external gitclaw",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo assets/harness-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.132",
    "@open-gitagent/protocol": "workspace:*",
    "@open-gitagent/sdk": "workspace:*",
    "@open-gitagent/session-store-mongo": "workspace:*",
    "deepagents": "^1.10.2",
    "@langchain/anthropic": "^1.3.0",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.3.0",
    "gitclaw": "^1.4.1",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@computeragent/engine-claude-agent-sdk": "workspace:*",
    "@computeragent/engine-deepagents": "workspace:*",
    "@computeragent/engine-gitagent": "workspace:*",
    "@computeragent/harness-server": "workspace:*",
    "@computeragent/identity-gitagentprotocol": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "agent-substrate",
    "subprocess",
    "computeragent"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/runtime-local"
  }
}
