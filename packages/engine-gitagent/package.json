{
  "name": "@computeragent/engine-gitagent",
  "version": "0.1.0",
  "description": "ComputerAgent EngineDriver plug-in that wraps gitclaw (gitagent — open-gitagent/gitagent).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@computeragent/protocol": "workspace:*",
    "gitclaw": "^1.4.1"
  },
  "devDependencies": {
    "@computeragent/harness-server": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "gitagent",
    "gitclaw",
    "engine-driver",
    "session-store"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/engine-gitagent"
  }
}
