{
  "name": "@computeragent/session-store-sqlite",
  "version": "0.1.0",
  "description": "SQLite-backed SessionStore for the ComputerAgent harness — third independent backend, used to stress-test the SessionStore contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@open-gitagent/protocol": "workspace:*",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@computeragent/harness-server": "workspace:*",
    "@computeragent/testing": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "session-store",
    "sqlite",
    "memory",
    "computeragent"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/session-store-sqlite"
  }
}
