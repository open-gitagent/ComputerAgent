{
  "name": "@computeragent/harness-server",
  "version": "0.1.0",
  "description": "Generic SSE+POST framework for agentic loops. Hosts pluggable EngineDrivers and IdentityLoaders.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@computeragent/protocol": "workspace:*",
    "hono": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@computeragent/testing": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
