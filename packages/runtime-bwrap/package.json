{
  "name": "@computeragent/runtime-bwrap",
  "version": "0.1.0",
  "description": "ComputerAgent substrate that runs the harness server inside a Bubblewrap (bwrap) sandbox — mount + PID + IPC + UTS + user namespaces, filesystem jail, capability drop. Linux-only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@open-gitagent/protocol": "workspace:*",
    "@open-gitagent/runtime-local": "workspace:*",
    "@open-gitagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "agent-substrate",
    "bubblewrap",
    "bwrap",
    "namespace-isolation",
    "computeragent"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/runtime-bwrap"
  }
}
