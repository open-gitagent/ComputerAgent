{
  "name": "@computeragent/sdk",
  "version": "0.1.0",
  "description": "ComputerAgent client SDK — typed, SSE-consuming TypeScript client for the Harness Protocol.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@computeragent/protocol": "workspace:*"
  },
  "devDependencies": {
    "@computeragent/harness-server": "workspace:*",
    "@computeragent/testing": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "agent-sdk",
    "harness-protocol",
    "anthropic",
    "claude",
    "sse-client",
    "typescript"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/sdk"
  }
}
