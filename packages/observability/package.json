{
  "name": "@computeragent/observability",
  "version": "0.1.0",
  "description": "OpenTelemetry GenAI observability for the ComputerAgent harness. Implements AuditSink to emit spec-compliant gen_ai.* spans, metrics, and events.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/attributes.d.ts",
      "import": "./dist/semantic/attributes.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@open-gitagent/protocol": "workspace:*",
    "@computeragent/harness-server": "workspace:*",
    "@opentelemetry/exporter-logs-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "opentelemetry",
    "otel",
    "observability",
    "gen-ai",
    "semantic-conventions",
    "tracing",
    "metrics",
    "computeragent"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/observability"
  }
}
