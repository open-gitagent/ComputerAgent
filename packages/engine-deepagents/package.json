{
  "name": "@computeragent/engine-deepagents",
  "version": "0.1.0",
  "description": "ComputerAgent EngineDriver plug-in that wraps LangChain's deepagents (deepagentsjs) — planning, sub-agents, filesystem-backed agent loop on LangGraph.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@computeragent/protocol": "workspace:*",
    "@langchain/anthropic": "^1.3.0",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.3.0",
    "deepagents": "^1.10.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@computeragent/harness-server": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai-agents",
    "langchain",
    "deepagents",
    "langgraph",
    "engine-driver"
  ],
  "homepage": "https://github.com/open-gitagent/ComputerAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-gitagent/ComputerAgent.git",
    "directory": "packages/engine-deepagents"
  }
}
