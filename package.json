{
  "name": "computeragent",
  "version": "0.1.0",
  "private": true,
  "description": "Run any GAP agent, anywhere, with any loop. Reference implementation of the Harness Protocol.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  }
}
